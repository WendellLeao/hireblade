@startuml

left to right direction
skinparam componentStyle rectangle

component "Hireblade.Application" as Application
component "Hireblade.Commands" as Commands
component "Hireblade.Debugging" as Debugging
component "Hireblade.Gameplay" as Gameplay
component "Hireblade.Gameplay.UI" as GameplayUI
component "Hireblade.Input" as Input
component "Hireblade.MainMenu" as MainMenu

together {
    component "Hireblade.Core" as Core
    component "Hireblade.Gameplay.Events" as Events
    component "Hireblade.Utilities" as Utilities
}

Application --> Core
Application --> Utilities
Application --> Gameplay
Application --> GameplayUI
Application --> MainMenu

Debugging --> Gameplay

Gameplay --> Commands
Gameplay --> Core
Gameplay --> Events
Gameplay --> Utilities

GameplayUI --> Core
GameplayUI --> Events

Events --> Core

Commands --> Utilities

MainMenu --> Core

note right of Input
  Wraps the new Input System
  (IInputService) but isn't
  referenced by any other
  module yet.
end note

@enduml
